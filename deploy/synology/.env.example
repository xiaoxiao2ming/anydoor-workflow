# 群晖共享文件夹不叫 docker 时，复制本文件为 .env 并改这一行
# （Container Manager「项目」会读取项目目录下的 .env）
CB_ROOT=/volume1/docker/client-base

# 画布访问口令（打开网页要输的密码）。改完执行：
#   cd /volume1/docker/client-base && sudo docker compose up -d   （或用 Container Manager 重启项目）
# 注意：密码是明文存在这个文件里的，别把 .env 提交到公开仓库。
CB_PASSWORD=xiao2ming

# OnlyOffice 文档服务的浏览器侧地址（在线编辑用）。NAS 的 IP 变了就改这里。
CB_DS_PUBLIC=http://192.168.1.16:8080

# 画布暴露给文档服务的地址（DS 回头拉文件/回传产物用）
CB_ORIGIN=http://192.168.1.16:5174
