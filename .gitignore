# ── 实测探针脚本与产物（批次 8~17 期间大量临时脚本，保留在盘上但不入库）──
# 这些是一次性 e2e / 探测脚本，用完即弃；重跑需要时看 git log 的提交说明重建
scripts/_*.mjs
scripts/probe-*.cjs
scripts/verify-*.cjs
scripts/diag-*.cjs
scripts/devconsole-viewer.html
# ★ 2026-10-17 白名单：下面这几个不是「一次性」脚本，是排查保存链/模板坑的常备工具，
#   丢了就得从头重写（_diag_log 能一键还原任一次保存的整条链）。其余 _* 仍不入库。
!scripts/_diag_log.mjs
!scripts/_check_oo_core.mjs
!scripts/_diag_e2e_dirty.mjs
!scripts/_diag_e2e_three_saves.mjs
!scripts/_diag_e2e_save_visible.mjs
!scripts/_probe_readfn.mjs
!scripts/_probe_editor_bin_content.mjs
# ★ 2026-10-17 第二批白名单（域引用/公式重算轮次）：
#   _verify_domain_recalc 用 x2t 转 csv 给「公式链算得对不对」当裁判，是唯一不靠引擎自证的验收；
#   _diag_e2e_refsync_formula 覆盖用户三条反馈（=参数 / =参数*2 / =A1*3）；
#   _diag_e2e_dirty_twice 覆盖「保存后再改不提示」这个反复复发的坑。
!scripts/_verify_domain_recalc.mjs
!scripts/_diag_e2e_refsync_formula.mjs
!scripts/_diag_e2e_dirty_twice.mjs
# ★ 2026-10-17 第三批白名单（操作审计日志）：
#   _verify_audit_log      —— 宿主侧点击/键盘/输入/弹窗落盘的端到端断言；
#   _verify_audit_oo       —— 编辑器两层 iframe 内的点击/键盘是否真的回到了宿主；
#   _verify_audit_electron —— 桌面端 IPC 通道（preload → ipcMain → logs/）。
#   三个脚本分别是「web 通道 / iframe 采集 / 桌面通道」的唯一自动化证据，必须留档。
!scripts/_verify_audit_log.mjs
!scripts/_verify_audit_oo.mjs
!scripts/_verify_audit_electron.mjs
# ★ 2026-10-17 第四批白名单（网页端同步发布）：
#   _verify_web_publish —— 网页形态的唯一端到端证据：版本号自证（标题栏 = /healthz）、
#   无 Office 服务时 OO 节点降级提示、审计日志在部署形态下仍落盘。
!scripts/_verify_web_publish.mjs
# ★ 2026-10-17 第五批白名单（访问口令）：
#   _verify_auth —— 门禁九连：未登录 302/401、healthz 不泄露、错口令 401、
#   对口令 302+cookie、带 cookie 200、logout 清凭证。本地与群晖线上通用。
!scripts/_verify_auth.mjs
# ★ 2026-10-17 第六批白名单（OO 远程桥）：
#   空白 OOXML 模板是服务端「空白新建」的兜底数据，与代码同生命周期。
!scripts/_blank_xlsx.b64
!scripts/_blank_docx.b64

