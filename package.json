{
  "name": "client-base",
  "version": "0.00.66",
  "private": true,
  "type": "module",
  "description": "客户端底座 starter：Electron + React + 元数据驱动多维表引擎（本地优先）",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && node scripts/check-cside-sync.mjs && electron .",
    "start:force": "electron .",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "node scripts/build-web.mjs",
    "web": "node scripts/build-web.mjs && node app-server.mjs dist-web 5174",
    "serve:web": "node app-server.mjs dist-web 5174",
    "publish:web": "node scripts/build-web.mjs && node scripts/publish-web.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:regress": "node scripts/check-regress.mjs",
    "check:roundtrip": "node scripts/check-roundtrip.mjs",
    "oo:scan": "node scripts/oo-scan.mjs",
    "oo:baseline": "node scripts/oo-scan.mjs --baseline",
    "oo:check": "node scripts/oo-scan.mjs --check",
    "oo:ds": "node scripts/oo-docservice.mjs",
    "oo:ver": "node scripts/oo-version.mjs",
    "oo:release": "node scripts/oo-version.mjs bump",
    "check:cside": "node scripts/check-cside-sync.mjs",
    "check:cside:rebuild": "node scripts/check-cside-sync.mjs --rebuild",
    "pack": "node scripts/pack-cside.mjs",
    "pack:lite": "node scripts/pack-cside.mjs --no-oo",
    "preflight": "node scripts/preflight.mjs",
    "pre:claim": "node scripts/preflight.mjs --claim",
    "pre:stat": "node scripts/preflight.mjs --stat",
    "pre:release": "node scripts/preflight.mjs --release",
    "dev:baseline": "node scripts/dev-baseline.mjs",
    "dev:collect": "node scripts/dev-baseline.mjs collect",
    "dev:preflight": "node scripts/dev-baseline.mjs preflight",
    "dev:snapshot": "node scripts/dev-baseline.mjs snapshot",
    "dev:diffcheck": "node scripts/dev-baseline.mjs check",
    "dev:journal": "node scripts/dev-baseline.mjs journal",
    "dev:status": "node scripts/dev-baseline.mjs report",
    "verify": "tsc --noEmit && vitest run && node scripts/check-regress.mjs && node scripts/oo-scan.mjs --check && node scripts/check-cside-sync.mjs",
    "release": "node scripts/release.mjs",
    "check:ooe2e": "node scripts/check-oo-e2e.mjs"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "@huggingface/transformers": "^4.3.2",
    "@office-kit/xlsx": "^0.18.0",
    "@tiptap/core": "2.11.5",
    "@tiptap/extension-color": "2.11.5",
    "@tiptap/extension-font-family": "2.11.5",
    "@tiptap/extension-highlight": "2.11.5",
    "@tiptap/extension-image": "2.11.5",
    "@tiptap/extension-subscript": "2.11.5",
    "@tiptap/extension-superscript": "2.11.5",
    "@tiptap/extension-table": "2.11.5",
    "@tiptap/extension-table-cell": "2.11.5",
    "@tiptap/extension-table-header": "2.11.5",
    "@tiptap/extension-table-row": "2.11.5",
    "@tiptap/extension-text-align": "2.11.5",
    "@tiptap/extension-text-style": "2.11.5",
    "@tiptap/extension-underline": "2.11.5",
    "@tiptap/pm": "2.11.5",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "@xyflow/react": "^12.3.5",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "cheerio": "^1.2.0",
    "docx": "^9.7.2",
    "docx-preview": "^0.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "mupdf": "^1.28.1",
    "node-llama-cpp": "^3.22.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^9.2.1",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "@tiptap/core": "2.11.5",
    "@tiptap/pm": "2.11.5",
    "@tiptap/extension-blockquote": "2.11.5",
    "@tiptap/extension-bold": "2.11.5",
    "@tiptap/extension-bullet-list": "2.11.5",
    "@tiptap/extension-code": "2.11.5",
    "@tiptap/extension-code-block": "2.11.5",
    "@tiptap/extension-document": "2.11.5",
    "@tiptap/extension-dropcursor": "2.11.5",
    "@tiptap/extension-gapcursor": "2.11.5",
    "@tiptap/extension-hard-break": "2.11.5",
    "@tiptap/extension-heading": "2.11.5",
    "@tiptap/extension-history": "2.11.5",
    "@tiptap/extension-horizontal-rule": "2.11.5",
    "@tiptap/extension-italic": "2.11.5",
    "@tiptap/extension-list-item": "2.11.5",
    "@tiptap/extension-ordered-list": "2.11.5",
    "@tiptap/extension-paragraph": "2.11.5",
    "@tiptap/extension-strike": "2.11.5",
    "@tiptap/extension-text": "2.11.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  }
}
